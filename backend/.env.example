# === Hindsight (memory) ===
# Hindsight Cloud: https://ui.hindsight.vectorize.io  (promo MEMHACK99 for $50 credit)
HINDSIGHT_BASE_URL=https://hindsight.vectorize.io
HINDSIGHT_API_KEY=
HINDSIGHT_BANK_ID=northpulse

# === Groq (LLM) ===
# https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# === Meta Graph API (Facebook Page + Instagram Business) ===
# Long-lived Page access token. Must have pages_read_engagement, pages_manage_posts,
# instagram_basic, instagram_content_publish, instagram_manage_insights.
META_ACCESS_TOKEN=
META_GRAPH_VERSION=v21.0
FB_PAGE_ID=
IG_BUSINESS_ACCOUNT_ID=

# === Competitor tracking ===
# Comma-separated Facebook Page IDs or Instagram usernames you want the agent to watch.
# For IG usernames use IG Business Discovery (requires the token to belong to another IG business).
COMPETITOR_IG_USERNAMES=
COMPETITOR_FB_PAGE_IDS=

# === App ===
APP_ENV=dev
APP_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173
SQLITE_PATH=./recall.db
